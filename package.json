{
  "name": "scala-steward-action",
  "description": "A GitHub Action to launch Scala Steward in your repository",
  "type": "module",
  "scripts": {
    "build": "npm run build-main && npm run build-post",
    "build-main": "ncc build --target es2024 src/action/main.ts && mv dist/index.js dist/main.js",
    "build-post": "ncc build --target es2024 src/action/post.ts && mv dist/index.js dist/post.js",
    "docs": "node src/utils/docs.ts && markdown-toc-gen update README.md",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "contributors:check": "all-contributors check",
    "test": "xo && vitest run --coverage",
    "all": "npm run build && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scala-steward-org/scala-steward-action.git"
  },
  "keywords": [
    "actions",
    "scala",
    "dependency-update",
    "scala-steward"
  ],
  "author": "alejandrohdezma",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/request": "^10.0.11"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^4.1.10",
    "all-contributors-cli": "^6.26.1",
    "js-yaml": "^5.2.2",
    "markdown-toc-gen": "^1.2.0",
    "ts-pattern": "^5.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "xo": "^2.0.2"
  },
  "xo": {
    "space": true,
    "semicolon": false,
    "rules": {
      "@typescript-eslint/naming-convention": 0,
      "@stylistic/curly-newline": [
        "error",
        {
          "multiline": true,
          "minElements": 1,
          "consistent": true
        }
      ]
    }
  }
}
